{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "description": "Nimbus dual-surface ecommerce monorepo — Next.js web + Expo mobile + shared catalog",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/catalog"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "start:web": "npm run start --workspace=web",
    "dev:mobile": "npm run start --workspace=nimbus-mobile",
    "lint:web": "npm run lint --workspace=web"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
